{
  "title": "Equity Final",
  "uid": "equity-final",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5m",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Producer \u2014 All-time totals (mode not distinguishable: job has no run_mode label)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Runs Total",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "producer_runs_total{job=\"equity_kafka_producer\"}",
          "instant": true
        }
      ]
    },
    {
