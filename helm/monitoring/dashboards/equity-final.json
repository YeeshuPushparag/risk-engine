{
  "title": "Equity Final Metrics",
  "uid": "equity-final",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "5m",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Producer — Final Metrics",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Runs Total",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(producer_runs_total{job=\"equity_kafka_producer\",mode=\"$run_mode\"} or producer_runs_total{exported_job=\"equity_kafka_producer\",mode=\"$run_mode\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failures Total",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(producer_failures_total{job=\"equity_kafka_producer\",mode=\"$run_mode\"} or producer_failures_total{exported_job=\"equity_kafka_producer\",mode=\"$run_mode\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "DLQ Total",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(producer_dlq_total{job=\"equity_kafka_producer\",mode=\"$run_mode\"} or producer_dlq_total{exported_job=\"equity_kafka_producer\",mode=\"$run_mode\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Kafka Msgs Sent",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(producer_kafka_messages_total{job=\"equity_kafka_producer\",mode=\"$run_mode\"} or producer_kafka_messages_total{exported_job=\"equity_kafka_producer\",mode=\"$run_mode\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Seconds Since Last Push",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "time() - max(producer_last_success_timestamp{job=\"equity_kafka_producer\",mode=\"$run_mode\"} or producer_last_success_timestamp{exported_job=\"equity_kafka_producer\",mode=\"$run_mode\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Missing Tickers",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(producer_missing_tickers_count{job=\"equity_kafka_producer\",mode=\"$run_mode\"} or producer_missing_tickers_count{exported_job=\"equity_kafka_producer\",mode=\"$run_mode\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Consumer — Final Metrics",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Batches Total",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "max(consumer_batches_total{job=\"equity_stream_consumer\",mode=\"$run_mode\"} or consumer_batches_total{exported_job=\"equity_stream_consumer\",mode=\"$run_mode\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Failures Total",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 6
      },
      "targets": [
        {
          "expr": "max(consumer_failures_total{job=\"equity_stream_consumer\",mode=\"$run_mode\"} or consumer_failures_total{exported_job=\"equity_stream_consumer\",mode=\"$run_mode\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "DLQ Total",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 6
      },
      "targets": [
        {
          "expr": "max(consumer_dlq_total{job=\"equity_stream_consumer\",mode=\"$run_mode\"} or consumer_dlq_total{exported_job=\"equity_stream_consumer\",mode=\"$run_mode\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "S3 Writes",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "max(consumer_processed_s3_writes_total{job=\"equity_stream_consumer\",mode=\"$run_mode\"} or consumer_processed_s3_writes_total{exported_job=\"equity_stream_consumer\",mode=\"$run_mode\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Records Processed",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 6
      },
      "targets": [
        {
          "expr": "max(consumer_records_processed_total{job=\"equity_stream_consumer\",mode=\"$run_mode\"} or consumer_records_processed_total{exported_job=\"equity_stream_consumer\",mode=\"$run_mode\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Seconds Since Last Push",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 6
      },
      "targets": [
        {
          "expr": "time() - max(consumer_last_success_timestamp{job=\"equity_stream_consumer\",mode=\"$run_mode\"} or consumer_last_success_timestamp{exported_job=\"equity_stream_consumer\",mode=\"$run_mode\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Replay Jobs Total (Replay mode)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "expr": "max(replay_jobs_total{job=\"equity_stream_consumer\",mode=\"$run_mode\"} or replay_jobs_total{exported_job=\"equity_stream_consumer\",mode=\"$run_mode\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Replay Records Processed (Replay mode)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 10
      },
      "targets": [
        {
          "expr": "max(replay_records_processed_total{job=\"equity_stream_consumer\",mode=\"$run_mode\"} or replay_records_processed_total{exported_job=\"equity_stream_consumer\",mode=\"$run_mode\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Replay Failures Total (Replay mode)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 10
      },
      "targets": [
        {
          "expr": "max(replay_failures_total{job=\"equity_stream_consumer\",mode=\"$run_mode\"} or replay_failures_total{exported_job=\"equity_stream_consumer\",mode=\"$run_mode\"})",
          "instant": true
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Final Records Processed Over Time",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "max(consumer_records_processed_total{job=\"equity_stream_consumer\",mode=\"$run_mode\"} or consumer_records_processed_total{exported_job=\"equity_stream_consumer\",mode=\"$run_mode\"})"
        }
      ]
    }
  ],
  "description": "Final Equity Kafka producer and consumer metrics pushed through Pushgateway. Real-time live pod metrics are intentionally excluded.",
  "templating": {
    "list": [
      {
        "name": "run_mode",
        "label": "Final Run Mode",
        "type": "custom",
        "query": "Live Final : live, Backfill : backfill, Replay : replay",
        "current": {
          "selected": true,
          "text": "Backfill",
          "value": "backfill"
        },
        "options": [
          {
            "selected": false,
            "text": "Live Final",
            "value": "live"
          },
          {
            "selected": true,
            "text": "Backfill",
            "value": "backfill"
          },
          {
            "selected": false,
            "text": "Replay",
            "value": "replay"
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false
      }
    ]
  }
}