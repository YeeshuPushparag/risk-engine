{
  "title": "Equity Batch Pipelines",
  "uid": "equity-batch",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "market_features_s3",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Status",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "pipeline_status{pipeline=\"market_features_s3\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Runtime (s)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "pipeline_runtime_seconds{pipeline=\"market_features_s3\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Last Run Mode / Run ID",
      "gridPos": {
        "h": 4,
        "w": 16,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "pipeline_status{pipeline=\"market_features_s3\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "pipeline": true,
              "Value": true
            },
            "renameByName": {
              "run_type": "Mode",
              "run_id": "Run ID",
              "dag_run_id": "DAG Run ID"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Input Rows",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "pipeline_input_rows{pipeline=\"market_features_s3\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Output Rows",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 5
      },
      "targets": [
        {
          "expr": "pipeline_output_rows{pipeline=\"market_features_s3\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Failed Tickers",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 5
      },
      "targets": [
        {
          "expr": "pipeline_failed_tickers{pipeline=\"market_features_s3\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Failure Rate",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "expr": "pipeline_failure_rate{pipeline=\"market_features_s3\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Anomaly Count",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 5
      },
      "targets": [
