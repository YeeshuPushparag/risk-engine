{
  "title": "FX Realtime (Producer/Consumer)",
  "uid": "fx-realtime",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "FX Producer (live)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Runs Total (rate/5m)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "rate(producer_runs_total{job=\"fx-producer\"}[5m])",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failures Total (rate/5m)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "rate(producer_failures_total{job=\"fx-producer\"}[5m])",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "DLQ Total (rate/5m)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "rate(producer_dlq_total{job=\"fx-producer\"}[5m])",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Kafka Msgs Sent (rate/5m)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "rate(producer_kafka_messages_total{job=\"fx-producer\"}[5m])",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Seconds Since Last Success",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "time() - producer_last_success_timestamp{job=\"fx-producer\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Missing Pairs",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "expr": "producer_missing_pairs_count{job=\"fx-producer\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Empty Pairs",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "producer_empty_pairs_count{job=\"fx-producer\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Invalid Pairs",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 5
      },
      "targets": [
        {
          "expr": "producer_invalid_pairs_count{job=\"fx-producer\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Producer Cycle Duration (p50/p95)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(producer_duration_seconds_bucket{job=\"fx-producer\"}[10m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(producer_duration_seconds_bucket{job=\"fx-producer\"}[10m]))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "FX Consumer (Spark)",
