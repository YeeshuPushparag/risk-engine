{
  "title": "FX Batch Pipelines",
  "uid": "fx-batch",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "fx_exposure_pipeline",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Status",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "pipeline_status{pipeline=\"fx_exposure_pipeline\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Runtime (s)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "pipeline_runtime_seconds{pipeline=\"fx_exposure_pipeline\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Last Run Mode / Run ID",
      "gridPos": {
        "h": 4,
        "w": 16,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "pipeline_status{pipeline=\"fx_exposure_pipeline\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "pipeline": true,
              "Value": true
            },
            "renameByName": {
              "run_type": "Mode",
              "run_id": "Run ID",
              "dag_run_id": "DAG Run ID"
            }
          }
        }
      ]
    },
    {
      "id": 5,
