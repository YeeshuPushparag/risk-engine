{
  "title": "Collateral Batch Pipeline",
  "uid": "collateral-batch",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "collateral_pipeline",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Status",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "pipeline_status{pipeline=\"collateral_pipeline\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Runtime (s)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "pipeline_runtime_seconds{pipeline=\"collateral_pipeline\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Last Run Mode / Run ID",
      "gridPos": {
        "h": 4,
        "w": 16,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "pipeline_status{pipeline=\"collateral_pipeline\"}",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "pipeline": true,
              "Value": true
            },
            "renameByName": {
              "run_type": "Mode",
              "run_id": "Run ID",
              "dag_run_id": "DAG Run ID"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Detail Rows",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "pipeline_detail_rows{pipeline=\"collateral_pipeline\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Model Rows",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 5
      },
      "targets": [
        {
          "expr": "pipeline_model_rows{pipeline=\"collateral_pipeline\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Unique Trades",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 5
      },
      "targets": [
        {
          "expr": "pipeline_unique_trades{pipeline=\"collateral_pipeline\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Unique Counterparties",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "expr": "pipeline_unique_counterparties{pipeline=\"collateral_pipeline\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Total Exposure",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 5
      },
      "targets": [
        {
          "expr": "pipeline_total_exposure{pipeline=\"collateral_pipeline\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Total Collateral",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 5
      },
      "targets": [
        {
          "expr": "pipeline_total_collateral{pipeline=\"collateral_pipeline\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Total Net Exposure",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "expr": "pipeline_total_net_exposure{pipeline=\"collateral_pipeline\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Margin Calls",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 9
      },
      "targets": [
        {
          "expr": "pipeline_margin_calls{pipeline=\"collateral_pipeline\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Reused Collateral",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 9
      },
      "targets": [
        {
          "expr": "pipeline_reused_collateral{pipeline=\"collateral_pipeline\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 14,
      "type": "state-timeline",
      "title": "collateral_pipeline \u2014 Status History",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "expr": "pipeline_status{pipeline=\"collateral_pipeline\"}"
        }
      ]
    }
  ]
}